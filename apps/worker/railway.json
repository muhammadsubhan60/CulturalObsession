{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @co/db generate && pnpm --filter @co/worker build",
    "watchPatterns": ["apps/worker/**", "packages/**", "pnpm-lock.yaml", ".node-version"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @co/worker start",
    "cronSchedule": "*/15 * * * *",
    "restartPolicyType": "NEVER",
    "multiRegionConfig": { "asia-southeast1-eqsg3a": { "numReplicas": 1 } }
  }
}
