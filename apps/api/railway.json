{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @co/db generate && pnpm --filter @co/api build",
    "watchPatterns": ["apps/api/**", "packages/**", "pnpm-lock.yaml", ".node-version"]
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter @co/db migrate:deploy",
    "startCommand": "pnpm --filter @co/api start",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "multiRegionConfig": { "asia-southeast1-eqsg3a": { "numReplicas": 1 } }
  }
}
