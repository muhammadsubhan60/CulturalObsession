{
  "name": "@co/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --clean",
    "start": "node dist/index.js",
    "seed:admin": "tsx --env-file-if-exists=.env src/scripts/seed-admin.ts",
    "import:catalogue": "tsx --env-file-if-exists=.env src/scripts/import-catalogue.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.9",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@co/db": "workspace:*",
    "@co/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "^1.7.14",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  }
}
