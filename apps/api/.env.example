NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://co:co_local_dev@localhost:5433/co_dev?schema=public
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# Production only: parent domain shared by web + api, e.g. culturalobsession.deltalabs.tech
COOKIE_DOMAIN=

# Media storage. Local: SeaweedFS from docker-compose.dev.yml.
S3_BUCKET=co-media
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:8333
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=co_local
S3_SECRET_ACCESS_KEY=co_local_secret
MEDIA_PUBLIC_URL=http://127.0.0.1:8333/co-media
